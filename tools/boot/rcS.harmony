# shellcheck shell=sh
# ha-harmony boot hook. Installed as /etc/init.d/rcS.harmony and **sourced** from
# /etc/init.d/rcS.local, which stock /etc/init.d/rcS sources at line 43.
#
# WHY SOURCED, AND WHAT THAT COSTS. We must set DEMO_MODE=1 in the shell that runs
# rcS, because rcS:84 starts stock `hal` only when DEMO_MODE != 1 and `hal` holds
# /dev/i2s and /dev/rfspi for its lifetime. A child process cannot set it. So:
#   * NEVER use `exit` here -- it would terminate rcS and leave the hub with no
#     dropbear (rcS:47), no hal and no luaworks. Use `return` only.
#   * A syntax error here aborts rcS the same way. `sh -n` is a test, not a habit.
#   * Variables leak into rcS's shell, so every name is prefixed hah_ and unset
#     at the end. DEMO_MODE is the one deliberate leak.
#
# WHY THE SYNCHRONOUS PART IS PURE FILE I/O. We are sourced at rcS:43, four lines
# before dropbear starts at rcS:47. Anything that blocks here happens *before there
# is any way to log in*, and a hang would mean no SSH, no stock stack, and recovery
# only by UART or factory reset. So the synchronous path does nothing but read and
# write small files in /cache and /etc: no network, no ioctl, no exec of our daemon,
# no waiting on anything. The daemon and its health watcher are backgrounded. That
# is what guarantees rcS reaches line 47 -- it is a load-bearing property, not a
# style preference, and tests/py/test_boot_hook.py enforces it.
#
# TOKEN NEVER ON ARGV. The daemon gets `--token-file <hub.conf>` and reads the token itself, so
# `ps` shows no secret. The token is still validated above (bad charset => stock, no strike).
#
# DEFERRED LAUNCH. Even the daemon start is not synchronous: a background subshell waits
# hah_delay seconds (dropbear and `ifup -a` come first), optionally stops luaworks/luadraws
# (they retry a TCP connection to the now-absent hal forever), then starts the daemon and
# watches it: bounded respawn after the health mark (see SUPERVISION). Daemon stdout/stderr go to tmpfs (/var/volatile),
# never /cache, so a chatty daemon cannot wear or fill flash; only hook lines go to /cache.
#
# SUPERVISION. Before the health mark a death is a strike and may reboot (unchanged). After it, a
# death respawns the daemon with backoff 5/30/120 s, at most respawn_max times per boot (conf
# key, default 3; 0 = never respawn, no heartbeat flag either). The budget refills after 1 h of
# continuous uptime; exhausted => log and stay inert. Respawns never reboot and never touch the
# strike counter. Wedge cover: the daemon rewrites its uptime seconds into a heartbeat file in
# tmpfs; one older than 60 s gets the daemon killed and respawned (same budget). The hardware
# watchdog stays off. Every log line carries an uptime stamp (hook lines also the date).
#
# SELF-DISABLE. /cache/ha-harmony-boot.n counts boots that started our daemon but
# were never confirmed healthy. Three strikes and we remove our own marker so the
# next boot is pure stock. This is the shape stock itself uses for its memtester
# mode (rcS.local: /cache/memtester.run present => "previous test crashed" => stop,
# do not retry). The counter lives in /cache (mtd5), a different partition from the
# binaries in /data (mtd4), so wiping either one independently is a recovery path.
#
# FAILURE CLASSES THAT KILL A SOURCED SHELL (all audited; none may appear on the sync path):
#   * a failed redirect on a POSIX special builtin (`:` `.` `export` `set` `eval` `exec`
#     `unset` `shift` `break`...) exits a non-interactive shell -- so redirects only ever go
#     on non-special commands or inside a ( subshell ) with 2>/dev/null;
#   * `.` of a missing file, and arithmetic on file content (`08` is an error that exits) --
#     file content is only ever matched with `case`, never fed to $(( ));
#   * `exit`, `set -e`, `cd`, `trap`, `shift`, changed IFS/umask: none, so nothing leaks.
#
# HOLDING /dev/i2s. The kernel runs ath_i2s_close on the LAST close of the open file, and a close
# of a speaker fd frees the DMA ring under live IRQs (hard freeze). So the daemon never opens or
# closes /dev/i2s: the watcher subshell write-opens it ONCE (fd 9, O_WRONLY: `9<>` would pick the
# mic slot) and the daemon inherits it as `--i2s-fd 9`. A daemon exit then never reaches the
# driver's release, because the watcher still holds the file. The watcher therefore never ends
# without a reboot: every path parks in a sleep loop. Never kill this shell (`killall sh`).
#
# BusyBox 1.13.4 floor: no timeout, no nohup, no setsid, no wc, no head, no find,
# no `command` builtin, no `grep -E`. Nothing here may use them.

hah_root="${HAH_ROOT:-}"
hah_marker="$hah_root/etc/ha-harmony-enable"
hah_counter="$hah_root/cache/ha-harmony-boot.n"
hah_log="$hah_root/var/volatile/ha-harmony-hook.log" # tmpfs: logs never touch flash; the daemon ships it to HA at start
hah_dlog="$hah_root/var/volatile/ha-harmony.log"
hah_pidfile="$hah_root/cache/ha-harmony.pid"
hah_dir="$hah_root/data/ha-harmony"
hah_daemon="$hah_dir/hub"
hah_conf="$hah_dir/hub.conf"
hah_nowd="$hah_root/etc/nowatchdog"
hah_i2s="${HAH_I2S_DEV:-/dev/i2s}"
# Signed-update files (written by the daemon, hub/ota/hub_ota.h): hub.prev = the build before the last
# update, ota-pending = "build=N" for a fresh build that has not reached the health mark, ota-restart =
# the daemon exited to be relaunched into the new build (its exit status, 42, is not visible to us),
# ota-rollback = what we leave behind after restoring hub.prev, for the daemon to report over ws.
hah_prev="$hah_dir/hub.prev"
hah_pending="$hah_dir/ota-pending"
hah_restart="$hah_dir/ota-restart"
hah_rbfile="$hah_dir/ota-rollback"
hah_bfile="$hah_dir/ota-build"
# Written at the health mark (tmpfs): the daemon refuses ota_begin until it exists, so an update never
# lands inside the health window of the build that is still proving itself.
hah_health="$hah_root/var/volatile/ha-harmony.healthy"
# Planned-restart marker (tmpfs, so a reboot clears it). tools/deploy_hub.py `restart` writes the hub's
# uptime seconds into it, then SIGTERMs the daemon. An exit with a fresh marker (<= 60 s old) is a deploy,
# not a crash: relaunch at once, no backoff, no respawn spent, no boot strike.
hah_pmark="$hah_root/tmp/ha-harmony-planned-restart"

# Numeric knobs (test overrides) are matched, never trusted: digits only, else the default.
hah_num() {
	case "$1" in
	'' | *[!0-9]* | 0[0-9]*) echo "$2" ;; # no leading zeros: `08` is an arithmetic error
	*) echo "$1" ;;
	esac
}
hah_limit=$(hah_num "${HAH_MAX_UNCLEAN:-}" 3)
hah_healthy=$(hah_num "${HAH_HEALTHY_SECS:-}" 120)
hah_delay=$(hah_num "${HAH_START_DELAY:-}" 20)
hah_step=$(hah_num "${HAH_POLL_SECS:-}" 5)
hah_logmax=$(hah_num "${HAH_LOG_MAX_LINES:-}" 2000)
[ "$hah_step" -ge 1 ] 2>/dev/null || hah_step=1
# Poll interval: seconds on the hub; tests may pass a fraction (HAH_POLL_SLEEP) and a poll count.
case "${HAH_POLL_SLEEP:-}" in
'' | *[!0-9.]*) hah_nap="$hah_step" ;;
*) hah_nap="$HAH_POLL_SLEEP" ;;
esac
hah_polls=$(hah_num "${HAH_HEALTHY_POLLS:-}" "")
[ "$hah_limit" -ge 1 ] 2>/dev/null || hah_limit=3

hah_hb="$hah_root/var/volatile/ha-harmony.hb"
hah_uptf="${HAH_UPTIME_FILE:-/proc/uptime}"
hah_stale=$(hah_num "${HAH_HB_STALE:-}" 60)
hah_refill=$(hah_num "${HAH_REFILL_SECS:-}" 3600)
# Respawn backoff (seconds; tests may pass fractions): 1st, 2nd, then every later respawn.
hah_b1=5
hah_b2=30
hah_b3=120
case "${HAH_BACKOFF1:-}" in '' | *[!0-9.]*) ;; *) hah_b1="$HAH_BACKOFF1" ;; esac
case "${HAH_BACKOFF2:-}" in '' | *[!0-9.]*) ;; *) hah_b2="$HAH_BACKOFF2" ;; esac
case "${HAH_BACKOFF3:-}" in '' | *[!0-9.]*) ;; *) hah_b3="$HAH_BACKOFF3" ;; esac
hah_wall=''
hah_exitf="$hah_root/var/volatile/ha-harmony.status" # tmpfs: the daemon's wait status, written by its launcher

# Sets hah_now (whole seconds of uptime, or empty) and hah_ts, the log prefix. Pure `read`: no
# fork, no arithmetic, safe on the synchronous path. The wall clock is added only in the
# background (date forks), and it is untrusted before NTP, hence uptime comes first.
hah_stamp() {
	hah_now=''
	read -r hah_now _ 2>/dev/null <"$hah_uptf"
	hah_now="${hah_now%%.*}"
	case "$hah_now" in '' | *[!0-9]* | 0[0-9]*) hah_now='' ;; esac
	hah_ts="up ${hah_now:-?}s"
	[ -n "$hah_wall" ] && hah_ts="$hah_ts $(date '+%Y-%m-%d %H:%M:%S' 2>/dev/null)"
}

# Restore hub.prev over the daemon ONCE for a fresh build that never reached the health mark ($1 is
# the reason), and record why. The pending marker is consumed either way and the rename consumes
# hub.prev, so this can never repeat for the same update. A missing or identical hub.prev (power cut
# before the swap) only clears the marker. Pure file I/O: safe on the synchronous path.
hah_rollback() {
	hah_rbl=''
	hah_rbp=''
	{ read -r hah_rbl; read -r hah_rbp; } 2>/dev/null <"$hah_pending"
	case "$hah_rbl" in
	build=*[!0-9]* | build=) hah_rbl='build=0' ;;
	build=[0-9]*) ;;
	*) hah_rbl='build=0' ;;
	esac
	case "$hah_rbp" in
	prev=*[!0-9]* | prev=) hah_rbp='' ;;
	prev=[0-9]*) hah_rbp="${hah_rbp#prev=}" ;;
	*) hah_rbp='' ;;
	esac
	rm -f "$hah_pending" 2>/dev/null
	hah_rbnote="pending update marker cleared ($1): no previous build to restore"
	# the daemon wrote the new build id to ota-build before the swap: put the previous one back whether or
	# not the binary changed (a cut before the rename leaves the old binary running)
	[ -n "$hah_rbp" ] && ( echo "$hah_rbp" >"$hah_bfile.tmp" ) 2>/dev/null && mv -f "$hah_bfile.tmp" "$hah_bfile" 2>/dev/null
	if [ -e "$hah_prev" ] && mv -f "$hah_prev" "$hah_daemon" 2>/dev/null; then
		if [ -e "$hah_prev" ]; then
			# mv of a hard link onto its own twin (power cut between link and rename) "succeeds" doing
			# nothing: hub.prev is the same file as the daemon, so just drop the extra name.
			rm -f "$hah_prev" 2>/dev/null
		else
			hah_stamp
			( echo "$hah_rbl"; echo "reason=$1"; echo "at=$hah_ts" ) >"$hah_rbfile.tmp" 2>/dev/null
			mv -f "$hah_rbfile.tmp" "$hah_rbfile" 2>/dev/null
			hah_rbnote="fresh build did not prove itself ($1, $hah_rbl): restored hub.prev"
		fi
	fi
	hah_blog "$hah_rbnote"
}

hah_say() {
	hah_stamp
	echo "[$hah_ts] ha-harmony: $1" 2>/dev/null >>"$hah_log"
	echo "ha-harmony: $1"
}

# Same line, log file only (the background watcher).
hah_blog() {
	hah_stamp
	echo "[$hah_ts] ha-harmony: $1" >>"$hah_log" 2>/dev/null
}

# Refuse to suppress stock unless everything we need is actually present. A missing
# binary or config must leave the hub fully stock, never inert.
if [ ! -x "$hah_daemon" ] || [ ! -r "$hah_conf" ]; then
	hah_say "daemon or config missing ($hah_daemon / $hah_conf) - leaving stock alone"
elif [ ! -e "$hah_nowd" ]; then
	# With the stock watchdog enabled, no hal and no lua would reboot the hub AFTER the
	# health mark, clearing the strike each time: an unbounded reboot loop. Stay stock.
	hah_say "$hah_nowd absent (stock watchdog enabled) - leaving stock alone"
else
	# Read config without sourcing it. Split each line at the FIRST '=' with parameter
	# expansion (values may themselves contain '='). Only these keys are honoured; any
	# bad value leaves stock alone and spends no strike (nothing was started).
	hah_cr=$(printf '\r' 2>/dev/null)
	hah_token=''
	hah_port=''
	hah_id=''
	hah_rf=''
	hah_slot=''
	hah_budget=''
	hah_budnote=''
	hah_stoplua=1
	hah_reboot=1
	hah_rmax=3
	hah_rdebug=0
	hah_otadev=0
	hah_bad=''
	hah_cap=''
	# `hah_line=''` first: some shells leave the old value at EOF, which would loop forever.
	# hah_cap is a hard bound (50 lines) as a second guard; a real conf has under 10.
	while hah_line=''; IFS= read -r hah_line || [ -n "$hah_line" ]; do
		hah_cap="${hah_cap}x"
		case "$hah_cap" in
		xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx*)
			hah_bad="conf has too many lines"
			break
			;;
		esac
		case "$hah_line" in
		*=*) ;;
		*) continue ;;
		esac
		hah_k="${hah_line%%=*}"
		hah_v="${hah_line#*=}"
		if [ -n "$hah_cr" ]; then
			case "$hah_v" in
			*"$hah_cr"*) hah_bad="$hah_k (carriage return)" ;;
			esac
		fi
		case "$hah_k" in
		token)
			# Length cap (daemon accepts 1-256): `${#}` yields a count, never file content as arithmetic.
			if [ "${#hah_v}" -gt 256 ]; then
				hah_bad="token (over 256 chars)"
			fi
			case "$hah_v" in
			'' | *[!A-Za-z0-9._~+/=-]*) hah_bad="token (empty or outside [A-Za-z0-9._~+/=-])" ;;
			*) hah_token="$hah_v" ;;
			esac
			;;
		port)
			case "$hah_v" in
			'' | *[!0-9]* | ??????*) hah_bad="port=$hah_v" ;;
			*) hah_port="$hah_v" ;;
			esac
			;;
		hub_id)
			case "$hah_v" in
			'' | *[!A-Za-z0-9._-]*) hah_bad="hub_id (outside [A-Za-z0-9._-])" ;;
			default) hah_budnote="hub_id=default is reserved - ignored, not pinned" ;;
			*)
				if [ "${#hah_v}" -gt 63 ]; then
					hah_budnote="hub_id is over 63 chars - ignored, not pinned" # logged after the per-boot truncation
				else
					hah_id="$hah_v"
				fi
				;;
			esac
			;;
		rf)
			case "$hah_v" in
			spi) hah_rf=spi ;;
			*) hah_bad="rf=$hah_v" ;;
			esac
			;;
		rf_slot)
			case "$hah_v" in
			'' | *[!0-9]* | ???*) hah_bad="rf_slot=$hah_v" ;;
			*) hah_slot="$hah_v" ;;
			esac
			;;
		config_budget_kib)
			case "$hah_v" in
			'' | *[!0-9]* | ???????*) hah_bad="config_budget_kib=$hah_v" ;;
			*)
				if [ "$hah_v" -lt 256 ]; then # the daemon's floor: ignore it (default budget), start anyway
					hah_budnote="config_budget_kib=$hah_v is below 256 - ignored" # logged after the per-boot truncation
				else
					hah_budget="$hah_v"
				fi
				;;
			esac
			;;
		stop_lua)
			case "$hah_v" in
			0 | 1) hah_stoplua="$hah_v" ;;
			*) hah_bad="stop_lua=$hah_v" ;;
			esac
			;;
		reboot_on_early_death)
			case "$hah_v" in
			0 | 1) hah_reboot="$hah_v" ;;
			*) hah_bad="reboot_on_early_death=$hah_v" ;;
			esac
			;;
		respawn_max)
			case "$hah_v" in
			0 | [1-9] | [1-9][0-9]) hah_rmax="$hah_v" ;;
			*) hah_bad="respawn_max=$hah_v" ;;
			esac
			;;
		rf_debug)
			case "$hah_v" in
			0 | 1) hah_rdebug="$hah_v" ;;
			*) hah_bad="rf_debug=$hah_v" ;;
			esac
			;;
		ota_allow_dev)
			case "$hah_v" in
			0 | 1) hah_otadev="$hah_v" ;;
			*) hah_bad="ota_allow_dev=$hah_v" ;;
			esac
			;;
		esac
	done <"$hah_conf"

	if [ -n "$hah_bad" ]; then
		hah_say "bad config value ($hah_bad) - leaving stock alone"
	elif [ -z "$hah_token" ]; then
		hah_say "no token in $hah_conf - leaving stock alone"
	else
		# --- strike counter ---------------------------------------------------
		# Only single digits are accepted from the file (no arithmetic on file content:
		# `08` is an arithmetic error that exits the shell). Anything else counts as 0.
		# A fresh signed build left its pending marker: the last boot never reached the health mark with
		# it (crash, early-death reboot, power cut). Back to the previous build, clean strike slate.
		if [ -e "$hah_pending" ]; then
			hah_rollback boot_unclean
			rm -f "$hah_counter" 2>/dev/null
		fi
		hah_n=$(cat "$hah_counter" 2>/dev/null)
		case "$hah_n" in
		0) hah_n=1 ;;
		1) hah_n=2 ;;
		2) hah_n=3 ;;
		3) hah_n=4 ;;
		4) hah_n=5 ;;
		5) hah_n=6 ;;
		6) hah_n=7 ;;
		7) hah_n=8 ;;
		8 | 9) hah_n=9 ;;
		*) hah_n=1 ;; # absent or corrupt counts as clean
		esac

		if [ "$hah_n" -ge "$hah_limit" ]; then
			# Too many unclean boots. Disable ourselves and let stock have this boot:
			# DEMO_MODE is deliberately NOT set, so rcS:84 starts hal normally. The
			# counter goes only once the marker is confirmed gone; if the marker cannot be
			# removed we still boot stock and keep the counter, never DEMO_MODE.
			rm -f "$hah_marker" 2>/dev/null
			if [ -e "$hah_marker" ]; then
				hah_say "cannot remove $hah_marker after $hah_n unclean boots - booting stock this time"
			else
				rm -f "$hah_counter" 2>/dev/null
				hah_say "DISABLED after $hah_n unclean boots - removed $hah_marker, booting stock"
			fi
		else
			# Persist the strike FIRST and read it back: if strike accounting cannot be
			# stored the bound on bad boots is gone, so leave stock alone.
			( echo "$hah_n" >"$hah_counter" ) 2>/dev/null
			hah_chk=$(cat "$hah_counter" 2>/dev/null)
			if [ "$hah_chk" != "$hah_n" ]; then
				hah_say "cannot persist the strike counter ($hah_counter) - leaving stock alone"
			else
				# Past this point we own the radios: stock hal must not start.
				DEMO_MODE=1
				export DEMO_MODE

				( : >"$hah_log" ) 2>/dev/null
				[ -n "$hah_rbnote" ] && hah_say "$hah_rbnote" # the per-boot truncation above ate the sync-path line
				[ -n "$hah_budnote" ] && hah_say "$hah_budnote"
				hah_say "starting (boot strike $hah_n of $hah_limit, port ${hah_port:-8099}, rf=${hah_rf:-none}, launch in ${hah_delay}s, reboot_on_early_death=$hah_reboot, respawn_max=$hah_rmax, rf_debug=$hah_rdebug)"

				# Everything below runs in the background: the delay, the optional lua
				# stop, the daemon and its watcher. Before the health mark a death is a
				# strike (and may reboot); after it the daemon is respawned a bounded number
				# of times, never rebooting and never touching the strike counter.
				(
					hah_wall=1
					# Fixed, quoted argv built with `set --`: no word splitting of paths.
					set -- --token-file "$hah_conf" --port "${hah_port:-8099}"
					[ -n "$hah_id" ] && set -- "$@" --hub-id "$hah_id"
					if [ -n "$hah_rf" ]; then
						set -- "$@" --rf-spi
						[ -n "$hah_slot" ] && set -- "$@" --rf-slot "$hah_slot"
					fi
					[ -n "$hah_budget" ] && set -- "$@" --config-budget "$hah_budget"
					[ "$hah_rmax" != 0 ] && set -- "$@" --heartbeat "$hah_hb"
					[ "$hah_rdebug" = 1 ] && set -- "$@" --rf-debug
					set -- "$@" --health-file "$hah_health"
					[ "$hah_otadev" = 1 ] && set -- "$@" --ota-allow-dev
					set -- "$@" --i2s-fd 9

					# Daemon output is prefixed with uptime, line by line.
					hah_tsloop() {
						while hah_l=''; IFS= read -r hah_l || [ -n "$hah_l" ]; do
							read -r hah_lu _ 2>/dev/null <"$hah_uptf"
							printf '[up %ss] %s\n' "${hah_lu%%.*}" "$hah_l"
						done
					}
					# Start the daemon through a tiny exec wrapper that records its own pid
					# ($! of a pipeline is the timestamper, not the daemon), then read it back.
					# The launcher shell stays as the daemon's parent only to record how it ended ($? = 128+N for a
					# signal N) in the tmpfs exit file; the pid we supervise (and kill -9) is the daemon's own.
					# Arithmetic lives here, in the backgrounded subshell, never on the synchronous path.
					# True (and the marker consumed) when a fresh planned-restart marker exists. Any other state is false;
					# a stale, empty or garbled marker is still removed so it cannot excuse a later crash.
					hah_planned() {
						[ -e "$hah_pmark" ] || return 1
						hah_pw=''
						read -r hah_pw 2>/dev/null <"$hah_pmark"
						rm -f "$hah_pmark" 2>/dev/null
						hah_stamp
						case "$hah_pw" in '' | *[!0-9]* | 0[0-9]* | ??????????*) return 1 ;; esac
						[ -n "$hah_now" ] || return 1
						hah_pw=$((hah_now - hah_pw))
						[ "$hah_pw" -ge 0 ] && [ "$hah_pw" -le 60 ]
					}

					hah_launch() {
						# A D-state daemon still holds fd 9 and the ring: never run two writers.
						while [ -n "$hah_pid" ] && kill -0 "$hah_pid" 2>/dev/null; do sleep "$hah_nap"; done
						rm -f "$hah_pidfile" "$hah_exitf" 2>/dev/null
						sh -c 'p="$1"; x="$2"; shift 2; "$@" & echo $! >"$p"; wait $!; echo $? >"$x"' sh "$hah_pidfile" "$hah_exitf" "$hah_daemon" "$@" 2>&1 </dev/null |
							hah_tsloop >>"$hah_dlog" 2>/dev/null &
						hah_pid=''
						hah_i=0
						while [ -z "$hah_pid" ] && [ "$hah_i" -lt 40 ]; do
							read -r hah_pid 2>/dev/null <"$hah_pidfile"
							case "$hah_pid" in '' | *[!0-9]*) hah_pid='' ;; esac
							[ -n "$hah_pid" ] || sleep "$hah_nap"
							hah_i=$((hah_i + 1))
						done
						hah_blog "daemon started pid ${hah_pid:-none}"
					}

					# Logs how the daemon ended (exit status, or the signal that killed it). The status file is
					# written a moment after the death is seen: look twice. File content only goes through `case`,
					# arithmetic only on a validated 129..159.
					hah_endnote() {
						hah_xs=''
						hah_xi=0
						while [ -z "$hah_xs" ] && [ "$hah_xi" -lt 2 ]; do
							read -r hah_xs 2>/dev/null <"$hah_exitf"
							case "$hah_xs" in '' | *[!0-9]* | ????*) hah_xs='' ;; esac
							[ -n "$hah_xs" ] || sleep "$hah_nap"
							hah_xi=$((hah_xi + 1))
						done
						hah_xw="status ${hah_xs:-unknown}"
						case "$hah_xs" in
						129 | 13[0-9] | 14[0-9] | 15[0-9])
							hah_xn=$((hah_xs - 128))
							case "$hah_xn" in
							4) hah_xg=" SIGILL" ;;
							6) hah_xg=" SIGABRT" ;;
							7) hah_xg=" SIGBUS" ;;
							8) hah_xg=" SIGFPE" ;;
							9) hah_xg=" SIGKILL" ;;
							11) hah_xg=" SIGSEGV" ;;
							13) hah_xg=" SIGPIPE" ;;
							15) hah_xg=" SIGTERM" ;;
							*) hah_xg='' ;;
							esac
							hah_xw="$hah_xw (killed by signal $hah_xn$hah_xg)"
							;;
						esac
						hah_blog "daemon ended: $hah_xw"
					}

					# No /dev/i2s: DEMO_MODE is already 1 so there is no stock stack either. Same rule as an early death,
					# regardless of the switch: reboot while the persisted strike advances to stock after hah_limit boots.
					hah_nodev() {
						hah_blog "cannot open $hah_i2s - no daemon, strike $hah_n stands"
						if [ "$(cat "$hah_counter" 2>/dev/null)" = "$hah_n" ]; then
							hah_blog "rebooting (no $hah_i2s)"
							hah_blog "watcher done"
							reboot
						else
							hah_blog "not rebooting (strike not persisted)"
						fi
					}

					sleep "$hah_delay"
					if [ "$hah_stoplua" = 1 ]; then
						# stock lua appears in ps as `lua` (and `luaworks` before it execs)
						killall lua luaworks luadraws >/dev/null 2>&1
						hah_blog "stopped lua/luaworks/luadraws"
					fi
					if [ -e "$hah_i2s" ]; then
						{
						: >"$hah_dlog" 2>/dev/null
						rm -f "$hah_health" 2>/dev/null
						hah_launch "$@"

						# Health window: poll (no `timeout` applet). Alive at the end means
						# port bound and radio held (the daemon exits non-zero otherwise).
						[ -n "$hah_polls" ] || hah_polls=$((hah_healthy / hah_step))
						hah_t=0
						hah_up=1
						while [ "$hah_t" -lt "$hah_polls" ]; do
							sleep "$hah_nap"
							hah_t=$((hah_t + 1))
							if ! kill -0 "$hah_pid" 2>/dev/null; then
								if hah_planned; then
									hah_blog "planned restart inside the health window - relaunching, no strike"
									hah_launch "$@"
									[ -n "$hah_pid" ] || {
										hah_up=0
										break
									}
									hah_t=0
									continue
								fi
								if [ -e "$hah_restart" ]; then
									# a planned relaunch into an applied update, not a death: no strike, and the
									# new build gets a fresh health window
									rm -f "$hah_restart" 2>/dev/null
									hah_blog "daemon exited for a signed update inside the health window - launching the new build"
									hah_launch "$@"
									[ -n "$hah_pid" ] || {
										hah_up=0
										break
									}
									hah_t=0
									continue
								fi
								if [ -e "$hah_pending" ]; then
									# the updated build died inside the window: previous build, once
									hah_blog "updated build died inside the health window"
									hah_rollback died_early
									hah_launch "$@"
									[ -n "$hah_pid" ] || {
										hah_up=0
										break
									}
									hah_t=0
									continue
								fi
								hah_endnote
								hah_up=0
								break
							fi
						done
						if [ "$hah_up" = 1 ]; then
							rm -f "$hah_counter" "$hah_pending" 2>/dev/null
							: >"$hah_health" 2>/dev/null
							hah_blog "healthy after ${hah_healthy}s - strikes cleared"
							# Supervision (after the health mark only). hah_used is the respawn
							# budget spent; it refills after hah_refill s of continuous uptime.
							hah_used=0
							hah_rs=''
							while :; do
								hah_stamp
								hah_rs="$hah_now"
								hah_hl=0
								hah_why=died
								while kill -0 "$hah_pid" 2>/dev/null; do
									sleep "$hah_nap"
									# Cap the tmpfs daemon log by LINE count. The daemon holds it open
									# O_APPEND (>>), so truncating in place is safe: its next write lands
									# at the new end, no hole. Byte size cannot be read portably: BusyBox
									# 1.13 `ls -l` has no date columns and `ls -ln` has extra ones, while
									# host `ls -l` has dates; there is no wc/stat. Counting lines with
									# `read` works everywhere (counting stops once over the cap).
									hah_nl=0
									# shellcheck disable=SC2034
									while IFS= read -r hah_l; do
										hah_nl=$((hah_nl + 1))
										[ "$hah_nl" -gt "$hah_logmax" ] && break
									done <"$hah_dlog" 2>/dev/null
									if [ "$hah_nl" -gt "$hah_logmax" ]; then
										: >"$hah_dlog" 2>/dev/null
									fi
									[ "$hah_rmax" != 0 ] || continue
									hah_stamp
									[ -n "$hah_now" ] && [ -n "$hah_rs" ] || continue
									if [ "$hah_used" -gt 0 ] && [ $((hah_now - hah_rs)) -ge "$hah_refill" ]; then
										hah_used=0
										hah_blog "respawn budget refilled after ${hah_refill}s of uptime"
									fi
									# Wedge cover: the daemon writes its uptime seconds to the heartbeat
									# file; a stale (or never written) one means it is alive but stuck.
									hah_h=''
									read -r hah_h 2>/dev/null <"$hah_hb"
									# An empty or unparsable read is no information: keep the last good value.
									case "$hah_h" in '' | *[!0-9]* | 0[0-9]*) hah_h="$hah_hl" ;; *) hah_hl="$hah_h" ;; esac
									hah_ref="$hah_rs"
									[ "$hah_h" -gt "$hah_ref" ] && hah_ref="$hah_h"
									if [ $((hah_now - hah_ref)) -gt "$hah_stale" ]; then
										hah_blog "heartbeat stale for over ${hah_stale}s - killing the wedged daemon"
										kill -9 "$hah_pid" 2>/dev/null
										wait "$hah_pid" 2>/dev/null
										hah_why=wedged
										break
									fi
								done
								if hah_planned; then
									# deploy restart: immediate, no backoff, budget and strikes untouched
									hah_blog "planned restart - relaunching now (respawn budget $hah_used of $hah_rmax unchanged)"
									hah_launch "$@"
									if [ -z "$hah_pid" ]; then
										hah_blog "planned restart: no pid recorded - not supervising any further (no respawn, no reboot)"
										break
									fi
									continue
								fi
								[ -e "$hah_restart" ] || hah_endnote
								if [ -e "$hah_restart" ]; then
									# The daemon applied a signed update and exited (status 42) to be relaunched:
									# no budget spent. The new build gets one health window; dying inside it
									# restores hub.prev once and relaunches that instead.
									rm -f "$hah_restart" 2>/dev/null
									hah_blog "daemon exited for a signed update - launching the new build"
									rm -f "$hah_health" 2>/dev/null # no further update until this build is proven
									hah_launch "$@"
									if [ -z "$hah_pid" ]; then
										hah_blog "update relaunch: no pid recorded - not supervising any further (no respawn, no reboot)"
										break
									fi
									hah_t=0
									hah_ok=1
									while [ "$hah_t" -lt "$hah_polls" ]; do
										sleep "$hah_nap"
										hah_t=$((hah_t + 1))
										if ! kill -0 "$hah_pid" 2>/dev/null; then
											if hah_planned; then
												hah_blog "planned restart inside the updated build's health window - relaunching, no rollback"
												hah_launch "$@"
												if [ -z "$hah_pid" ]; then
													hah_blog "planned restart: no pid recorded - not supervising any further (no respawn, no reboot)"
													break 2
												fi
												hah_t=0
												continue
											fi
											hah_ok=0
											break
										fi
									done
									if [ "$hah_ok" = 1 ]; then
										rm -f "$hah_pending" 2>/dev/null
										: >"$hah_health" 2>/dev/null
										hah_blog "updated build healthy after ${hah_healthy}s - previous build kept as hub.prev"
									else
										hah_blog "updated build died within ${hah_healthy}s"
										hah_rollback died_early
										hah_launch "$@"
										: >"$hah_health" 2>/dev/null # the restored build is the proven one
										if [ -z "$hah_pid" ]; then
											hah_blog "rollback relaunch: no pid recorded - not supervising any further (no respawn, no reboot)"
											break
										fi
									fi
									continue
								fi
								if [ "$hah_rmax" = 0 ]; then
									hah_blog "daemon died after health mark - no reboot, no respawn"
									break
								fi
								if [ "$hah_used" -ge "$hah_rmax" ]; then
									hah_blog "daemon $hah_why after health mark - respawn budget exhausted ($hah_used of $hah_rmax), leaving the hub inert (no reboot)"
									break
								fi
								case "$hah_used" in
								0) hah_bo="$hah_b1" ;;
								1) hah_bo="$hah_b2" ;;
								*) hah_bo="$hah_b3" ;;
								esac
								hah_used=$((hah_used + 1))
								hah_blog "daemon $hah_why after health mark - respawn $hah_used of $hah_rmax in ${hah_bo}s (no reboot)"
								sleep "$hah_bo"
								hah_launch "$@"
								if [ -z "$hah_pid" ]; then
									hah_blog "respawn: no pid recorded (pid file unwritable?) - not supervising any further (no respawn, no reboot)"
									break
								fi
							done
						else
							hah_blog "died within ${hah_healthy}s - strike $hah_n stands"
							# Reboot only if THIS boot's strike is really persisted, so the
							# strike counter bounds the reboot loop (boot 3 goes to stock).
							if [ "$hah_reboot" = 1 ] && [ "$(cat "$hah_counter" 2>/dev/null)" = "$hah_n" ]; then
								hah_blog "rebooting (reboot_on_early_death)"
								hah_blog "watcher done"
								reboot
							else
								hah_blog "not rebooting (switch off or strike not persisted)"
							fi
						fi
							# Never fall off the end: the watcher holds /dev/i2s for the life of the boot.
							hah_blog "holding $hah_i2s, parked"
							while :; do sleep 3600; done
						} 9>"$hah_i2s" || hah_nodev
					else
						hah_nodev
					fi
				) >/dev/null 2>&1 &
			fi
		fi
	fi
fi

unset hah_i2s hah_root hah_marker hah_counter hah_log hah_dlog hah_pidfile hah_dir hah_daemon hah_conf
unset hah_otadev hah_bfile hah_health hah_rbp hah_rbnote hah_prev hah_pending hah_restart hah_pmark hah_pw hah_rbfile hah_rbl hah_t hah_ok hah_nowd hah_nap hah_polls hah_cap hah_limit hah_healthy hah_delay hah_step hah_logmax hah_n hah_chk hah_token hah_port hah_id
unset hah_exitf hah_xs hah_xi hah_xw hah_xn hah_xg
unset hah_rf hah_slot hah_budget hah_budnote hah_stoplua hah_rmax hah_rdebug hah_hb hah_uptf hah_stale hah_refill hah_b1 hah_b2 hah_b3 hah_wall hah_now hah_ts hah_reboot hah_bad hah_k hah_v hah_line hah_cr
unset -f hah_endnote hah_say hah_blog hah_stamp hah_num hah_rollback 2>/dev/null
