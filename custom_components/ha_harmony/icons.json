{
  "entity": {
    "select": {
      "activity": {
        "default": "mdi:play-box-multiple"
      }
    },
    "sensor": {
      "addon_link": {
        "default": "mdi:puzzle",
        "state": {
          "not_linked": "mdi:puzzle-outline",
          "connecting": "mdi:puzzle-outline",
          "ok": "mdi:puzzle-check",
          "unreachable": "mdi:puzzle-remove",
          "auth_failed": "mdi:key-alert",
          "nothing_applied": "mdi:puzzle-outline",
          "rejected": "mdi:puzzle-remove"
        }
      },
      "page_format": {
        "default": "mdi:file-document-outline"
      },
      "bluetooth": {
        "default": "mdi:bluetooth",
        "state": {
          "off": "mdi:bluetooth-off",
          "no_adapter": "mdi:bluetooth-off",
          "disabled": "mdi:bluetooth-off"
        }
      },
      "device_input": {
        "default": "mdi:import"
      },
      "firmware_update": {
        "default": "mdi:update",
        "state": {
          "uploading": "mdi:upload",
          "applying": "mdi:cog-sync",
          "restarting": "mdi:restart",
          "installed": "mdi:check-circle",
          "failed": "mdi:alert-circle",
          "rolled_back": "mdi:undo-variant"
        }
      }
    },
    "binary_sensor": {
      "device_power": {
        "default": "mdi:power",
        "state": {
          "on": "mdi:power-plug",
          "off": "mdi:power-plug-off"
        }
      }
    },
    "event": {
      "keys": {
        "default": "mdi:remote"
      }
    },
    "button": {
      "command": {
        "default": "mdi:gesture-tap-button"
      }
    },
    "update": {
      "hub_firmware": {
        "default": "mdi:chip"
      }
    }
  },
  "services": {
    "reload_config": {
      "service": "mdi:cloud-refresh-variant"
    },
    "push_pages": {
      "service": "mdi:upload"
    },
    "send_ir": {
      "service": "mdi:remote"
    },
    "set_device_state": {
      "service": "mdi:power-settings"
    },
    "install_firmware": {
      "service": "mdi:cellphone-arrow-down"
    },
    "bt_pair": {
      "service": "mdi:bluetooth-connect"
    },
    "bt_stop_pairing": {
      "service": "mdi:bluetooth-off"
    },
    "bt_forget": {
      "service": "mdi:bluetooth-off"
    },
    "bt_listen": {
      "service": "mdi:remote"
    }
  }
}
